# Settings the app needs. On Vercel, add these under Project > Settings > Environment Variables.
# Never put real values in this file or upload them to GitHub.

# Filled in automatically when you connect a Neon database in Vercel's Storage tab.
DATABASE_URL=

# A long random value. Get one at https://generate-secret.vercel.app/32
AUTH_SECRET=

# From the Microsoft Entra app registration (setup guide, step 4).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Admins: can always edit and decide who else can edit. Comma-separated work emails.
ADMIN_EMAILS=

# Optional extra safety: only these email domains can sign in, e.g. cap.com.bd
ALLOWED_EMAIL_DOMAINS=
